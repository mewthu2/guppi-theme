{% doc %}
  Renders an inline SVG icon.

  @param {string} icon - Icon name
  @param {string} [class] - Extra CSS class

  @example
  {% render 'icon', icon: 'cart' %}
{% enddoc %}
<svg class="icon icon-{{ icon }} {{ class }}" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  {%- case icon -%}
    {%- when 'menu' -%}
      <path d="M3 7h18M3 12h18M3 17h18"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>
    {%- when 'cart' -%}
      <path d="M5 8h14l-1.2 11.1a2 2 0 0 1-2 1.9H8.2a2 2 0 0 1-2-1.9L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    {%- when 'chevron-down' -%}
      <path d="M6 9l6 6 6-6"/>
    {%- when 'chevron-left' -%}
      <path d="M15 6l-6 6 6 6"/>
    {%- when 'chevron-right' -%}
      <path d="M9 6l6 6-6 6"/>
    {%- when 'arrow-right' -%}
      <path d="M4 12h16M14 6l6 6-6 6"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'check' -%}
      <path d="M5 12.5l4.5 4.5L19 7"/>
    {%- when 'trash' -%}
      <path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/>
    {%- when 'filter' -%}
      <path d="M4 6h16M7 12h10M10 18h4"/>
    {%- when 'truck' -%}
      <path d="M3 6h11v10H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>
    {%- when 'leaf' -%}
      <path d="M5 19c0-8 5-14 15-14 0 10-6 15-14 15"/><path d="M5 19l7-7"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>
    {%- when 'star' -%}
      <path d="M12 3l2.8 5.8 6.2.9-4.5 4.4 1.1 6.2L12 17.4l-5.6 2.9 1.1-6.2L3 9.7l6.2-.9z" fill="currentColor"/>
    {%- when 'sparkle' -%}
      <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M19 16l.7 1.8 1.8.7-1.8.7L19 21l-.7-1.8-1.8-.7 1.8-.7z"/>
    {%- when 'drop' -%}
      <path d="M12 3s6 6.6 6 11a6 6 0 0 1-12 0c0-4.4 6-11 6-11z"/>
    {%- when 'shield' -%}
      <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>
    {%- when 'return' -%}
      <path d="M4 9h11a5 5 0 0 1 0 10H9"/><path d="M8 5L4 9l4 4"/>
    {%- when 'chat' -%}
      <path d="M4 5h16v11H9l-5 4z"/>
    {%- when 'gift' -%}
      <path d="M4 10h16v10H4zM3 7h18v3H3zM12 7v13"/><path d="M12 7c-2-4-6-3-5 0M12 7c2-4 6-3 5 0"/>
    {%- when 'globe' -%}
      <circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/>
    {%- when 'play' -%}
      <path d="M8 5l11 7-11 7z" fill="currentColor"/>
    {%- when 'drag' -%}
      <path d="M9 7l-5 5 5 5M15 7l5 5-5 5"/>
    {%- when 'instagram' -%}
      <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/>
    {%- when 'tiktok' -%}
      <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.5 2.5 2.3 4.3 5 4.5"/>
    {%- when 'facebook' -%}
      <path d="M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V10H6v3.5h3V21h3.5v-7.5H15l.5-3.5h-3V7a1 1 0 0 1 1-1H15z"/>
    {%- when 'youtube' -%}
      <rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10 9l5 3-5 3z" fill="currentColor"/>
    {%- when 'pinterest' -%}
      <circle cx="12" cy="12" r="9"/><path d="M11 8.5c3.5-1.5 6 1 5 4-.8 2.3-3.5 2.7-4.5 1M11.5 11L9 21"/>
    {%- when 'whatsapp' -%}
      <path d="M4 20l1.3-4A8 8 0 1 1 8 18.8z"/><path d="M9 9c0 3 3 6 6 6l1-1.5-2-1-1 .8c-1-.4-2-1.4-2.4-2.4l.8-1-1-2z"/>
    {%- else -%}
      <circle cx="12" cy="12" r="9"/>
  {%- endcase -%}
</svg>
