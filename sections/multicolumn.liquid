<section class="section multicolumn color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header text-{{ section.settings.heading_alignment }}">
        {%- if section.settings.subheading != blank -%}<p class="subheading">{{ section.settings.subheading }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <div class="multicolumn__grid{% if section.settings.mobile_carousel %} multicolumn__grid--scroll{% endif %}" style="--columns: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <div class="column column--{{ section.settings.style }} text-{{ section.settings.text_alignment }} reveal" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="column__media media" style="--ratio: {{ section.settings.ratio }};">
              {{ block.settings.image | image_url: width: 900 | image_tag: widths: '300, 500, 700, 900', sizes: '(min-width: 990px) 25vw, 80vw', loading: 'lazy' }}
            </div>
          {%- elsif block.settings.icon != 'none' -%}
            <div class="column__icon">{% render 'icon', icon: block.settings.icon %}</div>
          {%- endif -%}
          <div class="column__body">
            {%- if block.settings.heading != blank -%}<h3 class="h4">{{ block.settings.heading }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
            {%- assign linked = block.settings.product -%}
            {%- if linked != blank -%}
              <a href="{{ linked.url }}" class="mini-product mini-product--compact">
                <span class="mini-product__media">
                  {%- if linked.featured_image -%}{{ linked.featured_image | image_url: width: 160 | image_tag: loading: 'lazy' }}{%- endif -%}
                </span>
                <span>
                  <span class="mini-product__title">{{ linked.title }}</span>
                  {% render 'price', product: linked %}
                </span>
              </a>
            {%- endif -%}
            {%- if block.settings.link_label != blank -%}
              <a href="{{ block.settings.link | default: '#' }}" class="link link--arrow">{{ block.settings.link_label }} {% render 'icon', icon: 'arrow-right' %}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <div class="button-group button-group--center"><a href="{{ section.settings.button_link | default: '#' }}" class="button">{{ section.settings.button_label }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Multicoluna",
  "class": "section-multicolumn",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Monte sua rotina" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Passos básicos de skincare" },
    { "type": "text_alignment", "id": "heading_alignment", "label": "Alinhamento do título", "default": "center" },
    { "type": "range", "id": "columns", "min": 1, "max": 5, "step": 1, "label": "Colunas no desktop", "default": 4 },
    { "type": "select", "id": "style", "label": "Estilo", "options": [ { "value": "plain", "label": "Simples" }, { "value": "card", "label": "Card" } ], "default": "card" },
    { "type": "select", "id": "ratio", "label": "Proporção das imagens", "options": [ { "value": "1", "label": "Quadrado" }, { "value": "0.8", "label": "Retrato" }, { "value": "1.5", "label": "Paisagem" } ], "default": "1" },
    { "type": "text_alignment", "id": "text_alignment", "label": "Alinhamento do texto", "default": "left" },
    { "type": "checkbox", "id": "mobile_carousel", "label": "Carrossel no mobile", "default": true },
    { "type": "text", "id": "button_label", "label": "Botão" },
    { "type": "url", "id": "button_link", "label": "Link do botão" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de cores", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Espaçamento superior", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Espaçamento inferior", "default": 64 }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Coluna",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem" },
        { "type": "select", "id": "icon", "label": "Ícone (se não houver imagem)", "options": [ { "value": "none", "label": "Nenhum" }, { "value": "heart", "label": "Coração" }, { "value": "leaf", "label": "Folha" }, { "value": "sparkle", "label": "Brilho" }, { "value": "drop", "label": "Gota" }, { "value": "shield", "label": "Escudo" }, { "value": "truck", "label": "Caminhão" }, { "value": "return", "label": "Devolução" }, { "value": "chat", "label": "Chat" }, { "value": "gift", "label": "Presente" } ], "default": "sparkle" },
        { "type": "text", "id": "heading", "label": "Título", "default": "1. Demaquilar" },
        { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Remova maquiagem, protetor solar e impurezas com um bálsamo de limpeza suave.</p>" },
        { "type": "product", "id": "product", "label": "Produto relacionado" },
        { "type": "text", "id": "link_label", "label": "Texto do link" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicoluna",
      "blocks": [
        { "type": "column", "settings": { "heading": "1. Demaquilar", "icon": "drop" } },
        { "type": "column", "settings": { "heading": "2. Limpar", "icon": "sparkle", "text": "<p>Renove a pele com um gel de limpeza leve que remove o excesso de oleosidade.</p>" } },
        { "type": "column", "settings": { "heading": "3. Hidratar", "icon": "heart", "text": "<p>Sele a hidratação com um creme nutritivo que deixa a pele macia e saudável.</p>" } },
        { "type": "column", "settings": { "heading": "4. Proteger", "icon": "shield", "text": "<p>Proteja a pele todos os dias com um FPS leve e confortável.</p>" } }
      ]
    }
  ]
}
{% endschema %}
