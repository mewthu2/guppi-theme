{% doc %}
  Renders customer address form fields.

  @param {object} form - Customer address form object
  @param {string} id - Unique ID suffix

  @example
  {% render 'address-fields', form: form, id: 'new' %}
{% enddoc %}
<div class="contact__row">
  <label class="field"><span class="field__label">{{ 'customer.register.first_name' | t }}</span><input class="field__input" type="text" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></label>
  <label class="field"><span class="field__label">{{ 'customer.register.last_name' | t }}</span><input class="field__input" type="text" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></label>
</div>
<label class="field"><span class="field__label">{{ 'customer.addresses.company' | t }}</span><input class="field__input" type="text" name="address[company]" value="{{ form.company }}" autocomplete="organization"></label>
<label class="field"><span class="field__label">{{ 'customer.addresses.address1' | t }}</span><input class="field__input" type="text" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1"></label>
<label class="field"><span class="field__label">{{ 'customer.addresses.address2' | t }}</span><input class="field__input" type="text" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2"></label>
<div class="contact__row">
  <label class="field"><span class="field__label">{{ 'customer.addresses.city' | t }}</span><input class="field__input" type="text" name="address[city]" value="{{ form.city }}" autocomplete="address-level2"></label>
  <label class="field"><span class="field__label">{{ 'customer.addresses.zip' | t }}</span><input class="field__input" type="text" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code"></label>
</div>
<div class="contact__row">
  <label class="field">
    <span class="field__label">{{ 'customer.addresses.country' | t }}</span>
    <select class="field__input" name="address[country]" data-default="{{ form.country }}" autocomplete="country">{{ all_country_option_tags }}</select>
  </label>
  <label class="field">
    <span class="field__label">{{ 'customer.addresses.province' | t }}</span>
    <input class="field__input" type="text" name="address[province]" value="{{ form.province }}" autocomplete="address-level1">
  </label>
</div>
<label class="field"><span class="field__label">{{ 'customer.addresses.phone' | t }}</span><input class="field__input" type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel"></label>
<label class="checkbox"><input type="checkbox" id="AddressDefault-{{ id }}" name="address[default]" value="1"{% if form.set_as_default_checkbox contains 'checked' %} checked{% endif %}> <span>{{ 'customer.addresses.set_default' | t }}</span></label>
