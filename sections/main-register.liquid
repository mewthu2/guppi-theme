<section class="section customer color-{{ section.settings.color_scheme }}" style="--pt: 64px; --pb: 64px;">
  <div class="customer__box">
    <h1 class="h2 text-center">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', novalidate: 'novalidate', class: 'customer__form' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label class="field"><span class="field__label">{{ 'customer.register.first_name' | t }}</span><input class="field__input" type="text" name="customer[first_name]" autocomplete="given-name"></label>
      <label class="field"><span class="field__label">{{ 'customer.register.last_name' | t }}</span><input class="field__input" type="text" name="customer[last_name]" autocomplete="family-name"></label>
      <label class="field"><span class="field__label">{{ 'customer.login_page.email' | t }}</span><input class="field__input" type="email" name="customer[email]" autocomplete="email" required></label>
      <label class="field"><span class="field__label">{{ 'customer.login_page.password' | t }}</span><input class="field__input" type="password" name="customer[password]" autocomplete="new-password" required></label>
      <label class="checkbox"><input type="checkbox" name="customer[accepts_marketing]"> <span>{{ 'customer.register.marketing' | t }}</span></label>
      <button type="submit" class="button button--full">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Cadastro",
  "settings": [ { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de cores", "default": "scheme-2" } ]
}
{% endschema %}
