<link
  href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap"
  rel="stylesheet"
>

<style>
  #shopify-section-{{ section.id }} .guppi-password {
    box-sizing: border-box;
    min-height: 100vh;
    min-height: 100svh;
    padding: 60px 24px 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #9275b8;
    color: #f6f3ea;
    font-family: "DM Sans", Arial, sans-serif;
  }

  #shopify-section-{{ section.id }} .guppi-password * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .guppi-password__inner {
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .guppi-password__logo {
    display: block;
    width: 480px;
    max-width: 90%;
    height: auto;
    max-height: none;
    margin: 0 auto 44px;
  }

  #shopify-section-{{ section.id }} .guppi-password__title {
    margin: 0 0 20px;
    color: #f6f3ea;
    font-family: "DM Sans", Arial, sans-serif;
    font-size: clamp(30px, 3.5vw, 44px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  #shopify-section-{{ section.id }} .guppi-password__description {
    max-width: 500px;
    margin: 0 auto;
    color: #f6f3ea;
    font-size: 17px;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .guppi-password__invitation {
    margin: 28px 0 16px;
    color: #f6f3ea;
    font-size: 16px;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .guppi-password__newsletter {
    width: 100%;
    max-width: 490px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .guppi-password input,
  #shopify-section-{{ section.id }} .guppi-password button {
    font-family: "DM Sans", Arial, sans-serif;
  }

  #shopify-section-{{ section.id }} .guppi-password input[type="email"] {
    min-width: 0;
    background: #f6f3ea;
    color: #322c3d;
    border-radius: 999px;
  }

  #shopify-section-{{ section.id }} .guppi-password input[type="email"]::placeholder {
    color: #655b70;
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .guppi-password button[type="submit"] {
    background: #322c3d;
    color: #f6f3ea;
    border-color: #322c3d;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .guppi-password__footer {
    margin-top: 52px;
  }

  #shopify-section-{{ section.id }} .guppi-password__login {
    margin: 0 auto 24px;
    font-size: 13px;
  }

  #shopify-section-{{ section.id }} .guppi-password__login summary {
    display: inline-block;
    color: #f6f3ea;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 4px;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .guppi-password__login summary::-webkit-details-marker {
    display: none;
  }

  #shopify-section-{{ section.id }} .guppi-password__login form {
    max-width: 390px;
    margin: 20px auto 0;
  }

  #shopify-section-{{ section.id }} .guppi-password__footer a {
    color: #f6f3ea;
  }

  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} .guppi-password {
      padding: 44px 22px 28px;
    }

    #shopify-section-{{ section.id }} .guppi-password__logo {
      width: 280px;
      margin-bottom: 34px;
    }

    #shopify-section-{{ section.id }} .guppi-password__description {
      font-size: 16px;
    }

    #shopify-section-{{ section.id }} .guppi-password__footer {
      margin-top: 40px;
    }
  }
</style>

<section class="guppi-password color-{{ section.settings.color_scheme }}">
  <div class="guppi-password__inner">

    {%- if settings.logo != blank -%}
      {{
        settings.logo
        | image_url: width: 1200
        | image_tag:
          class: 'guppi-password__logo',
          alt: shop.name,
          loading: 'eager'
      }}
    {%- else -%}
      <p class="guppi-password__title">{{ shop.name }}</p>
    {%- endif -%}

    <h1 class="guppi-password__title">
      {{ section.settings.heading | default: 'Falta pouco para sentir.' }}
    </h1>

    <p class="guppi-password__description">
      Vanilla Cashmere. A primeira fragrância da GÜPPI.
    </p>

    <p class="guppi-password__invitation">
      Faça parte do universo GÜPPI.
    </p>

    <div class="guppi-password__newsletter">
      {% render 'newsletter-form', id: section.id %}
    </div>

    <div class="guppi-password__footer">
      <details class="guppi-password__login">
        <summary>
          {{ 'general.password_page.login_link' | t }}
        </summary>

        {%- form 'storefront_password', class: 'customer__form' -%}
          {%- if form.errors -%}
            <div class="form-message form-message--error">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <label class="field">
            <span class="field__label">
              {{ 'general.password_page.password' | t }}
            </span>

            <input
              class="field__input"
              type="password"
              name="password"
              autocomplete="current-password"
              required
            >
          </label>

          <button type="submit" class="button">
            {{ 'general.password_page.enter' | t }}
          </button>
        {%- endform -%}
      </details>

      {% render 'social-icons' %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Senha",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Falta pouco para sentir."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cores",
      "default": "scheme-2"
    }
  ]
}
{% endschema %}