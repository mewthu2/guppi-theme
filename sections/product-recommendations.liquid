<product-recommendations
  class="section product-recommendations color-{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent={{ section.settings.intent }}"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page-width">
      <div class="section-header section-header--row">
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </div>
      <slider-component class="slider">
        <ul class="product-grid slider__track" role="list" style="--columns: {{ section.settings.columns }};" data-track>
          {%- for product in recommendations.products -%}
            <li class="slider__item">{% render 'product-card', product: product %}</li>
          {%- endfor -%}
        </ul>
        <div class="slider__buttons">
          <button type="button" class="icon-button icon-button--filled" data-prev aria-label="{{ 'accessibility.previous_slide' | t }}">{% render 'icon', icon: 'chevron-left' %}</button>
          <button type="button" class="icon-button icon-button--filled" data-next aria-label="{{ 'accessibility.next_slide' | t }}">{% render 'icon', icon: 'chevron-right' %}</button>
        </div>
      </slider-component>
    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "Recomendações",
  "tag": "section",
  "class": "section-recommendations",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Você também pode gostar" },
    { "type": "select", "id": "intent", "label": "Tipo", "options": [ { "value": "related", "label": "Relacionados" }, { "value": "complementary", "label": "Complementares" } ], "default": "related" },
    { "type": "range", "id": "limit", "min": 2, "max": 10, "step": 1, "label": "Máximo de produtos", "default": 8 },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Colunas no desktop", "default": 4 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de cores", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Espaçamento superior", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Espaçamento inferior", "default": 64 }
  ],
  "presets": [ { "name": "Recomendações" } ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
