<div class="sliding-text color-{{ section.settings.color_scheme }} sliding-text--{{ section.settings.size }}{% if section.settings.reverse %} sliding-text--reverse{% endif %}{% if section.settings.tilt %} sliding-text--tilt{% endif %}" style="--marquee-speed: {{ section.settings.speed }}s; --pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="marquee">
    {%- for i in (1..2) -%}
      <div class="marquee__track"{% if forloop.last %} aria-hidden="true"{% endif %}>
        {%- for j in (1..3) -%}
          {%- for block in section.blocks -%}
            <span class="sliding-text__item" {% if forloop.parentloop.first and i == 1 %}{{ block.shopify_attributes }}{% endif %}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: height: 160 | image_tag: loading: 'lazy', class: 'sliding-text__image', alt: '' }}
              {%- endif -%}
              {{ block.settings.text }}
            </span>
            <span class="sliding-text__sep" aria-hidden="true">{% render 'icon', icon: section.settings.separator %}</span>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Texto deslizante",
  "tag": "section",
  "class": "section-sliding-text",
  "max_blocks": 8,
  "settings": [
    { "type": "select", "id": "size", "label": "Tamanho do texto", "options": [ { "value": "small", "label": "Pequeno" }, { "value": "medium", "label": "Médio" }, { "value": "large", "label": "Grande" } ], "default": "large" },
    { "type": "select", "id": "separator", "label": "Separador", "options": [ { "value": "sparkle", "label": "Brilho" }, { "value": "star", "label": "Estrela" }, { "value": "heart", "label": "Coração" }, { "value": "drop", "label": "Gota" }, { "value": "leaf", "label": "Folha" } ], "default": "sparkle" },
    { "type": "range", "id": "speed", "min": 10, "max": 80, "step": 2, "unit": "s", "label": "Duração da animação", "default": 30 },
    { "type": "checkbox", "id": "reverse", "label": "Inverter direção", "default": false },
    { "type": "checkbox", "id": "tilt", "label": "Inclinar faixa", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de cores", "default": "scheme-4" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Espaçamento superior", "default": 20 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Espaçamento inferior", "default": 20 }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Texto",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "Glow natural" },
        { "type": "image_picker", "id": "image", "label": "Imagem pequena (opcional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Texto deslizante",
      "blocks": [
        { "type": "text", "settings": { "text": "Cruelty-free" } },
        { "type": "text", "settings": { "text": "100% vegano" } },
        { "type": "text", "settings": { "text": "Glow natural" } }
      ]
    }
  ]
}
{% endschema %}
