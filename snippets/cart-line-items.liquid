{% doc %}
  Renders the list of cart line items with quantity controls.

  @param {string} [context] - 'drawer' or 'page'

  @example
  {% render 'cart-line-items', context: 'drawer' %}
{% enddoc %}
<ul class="cart-items cart-items--{{ context | default: 'drawer' }}" role="list">
  {%- for item in cart.items -%}
    <li class="cart-item" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
      <a href="{{ item.url }}" class="cart-item__media" tabindex="-1" aria-hidden="true">
        {%- if item.image -%}
          {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.title }}
        {%- endif -%}
      </a>
      <div class="cart-item__details">
        <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>
        {%- unless item.product.has_only_default_variant -%}
          <p class="cart-item__variant">{{ item.variant.title }}</p>
        {%- endunless -%}
        {%- for property in item.properties -%}
          {%- assign first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and first_char != '_' -%}
            <p class="cart-item__variant">{{ property.first }}: {{ property.last }}</p>
          {%- endif -%}
        {%- endfor -%}
        {%- if item.selling_plan_allocation -%}
          <p class="cart-item__variant">{{ item.selling_plan_allocation.selling_plan.name }}</p>
        {%- endif -%}
        <div class="cart-item__price">
          {%- if item.original_line_price != item.final_line_price -%}
            <s class="price__compare">{{ item.original_line_price | money }}</s>
          {%- endif -%}
          <span>{{ item.final_line_price | money }}</span>
        </div>
        {%- for discount in item.line_level_discount_allocations -%}
          <p class="cart-item__discount">{% render 'icon', icon: 'gift' %} {{ discount.discount_application.title }} (-{{ discount.amount | money }})</p>
        {%- endfor -%}
        <div class="cart-item__actions">
          <quantity-input class="quantity quantity--small" data-line="{{ forloop.index }}">
            <button type="button" name="minus" class="quantity__btn" aria-label="{{ 'products.product.quantity.decrease' | t }}">{% render 'icon', icon: 'minus' %}</button>
            <input class="quantity__input" type="number" name="updates[]" value="{{ item.quantity }}" min="0" data-line="{{ forloop.index }}" aria-label="{{ 'products.product.quantity.label' | t }}">
            <button type="button" name="plus" class="quantity__btn" aria-label="{{ 'products.product.quantity.increase' | t }}">{% render 'icon', icon: 'plus' %}</button>
          </quantity-input>
          <a href="{{ item.url_to_remove }}" class="cart-item__remove" data-remove-line="{{ forloop.index }}" aria-label="{{ 'cart.general.remove' | t: title: item.title }}">
            {% render 'icon', icon: 'trash' %}
          </a>
        </div>
      </div>
    </li>
  {%- endfor -%}
</ul>
