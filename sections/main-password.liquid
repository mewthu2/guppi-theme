<link
  href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap"
  rel="stylesheet"
>

<style>
  #shopify-section-{{ section.id }} .password {
    min-height: 100svh;
    padding: 64px 24px 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "DM Sans", Arial, sans-serif;
  }

  #shopify-section-{{ section.id }} .password__inner {
    width: 100%;
    max-width: 620px;
    margin: 0 auto;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .password__logo {
    display: block;
    width: 220px;
    max-width: 80%;
    height: auto;
    max-height: none;
    margin: 0 auto 48px;
  }

  #shopify-section-{{ section.id }} .password__title {
    font-family: "DM Sans", Arial, sans-serif;
    font-size: clamp(34px, 4.5vw, 52px);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.035em;
    margin: 0 0 22px;
    color: #f6f3ea;
  }

  #shopify-section-{{ section.id }} .password__description {
    max-width: 440px;
    margin: 0 auto 32px;
    font-size: 17px;
    line-height: 1.6;
    color: #f6f3ea;
  }

  #shopify-section-{{ section.id }} .password__newsletter {
    max-width: 490px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .password input,
  #shopify-section-{{ section.id }} .password button {
    font-family: "DM Sans", Arial, sans-serif;
  }

  #shopify-section-{{ section.id }} .password input[type="email"] {
    background: #f6f3ea;
    color: #322c3d;
    border-radius: 999px;
  }

  #shopify-section-{{ section.id }} .password input[type="email"]::placeholder {
    color: #655b70;
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .password button[type="submit"] {
    background: #322c3d;
    color: #f6f3ea;
    border-color: #322c3d;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .password__footer {
    margin-top: 64px;
  }

  #shopify-section-{{ section.id }} .password__login {
    margin: 0 auto 24px;
    font-size: 13px;
  }

  #shopify-section-{{ section.id }} .password__login summary {
    color: #f6f3ea;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .password__login form {
    margin-top: 20px;
  }

  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} .password {
      padding: 48px 24px 28px;
    }

    #shopify-section-{{ section.id }} .password__logo {
      width: 170px;
      margin-bottom: 36px;
    }

    #shopify-section-{{ section.id }} .password__description {
      font-size: 16px;
    }

    #shopify-section-{{ section.id }} .password__footer {
      margin-top: 48px;
    }
  }
</style>

<section class="password color-{{ section.settings.color_scheme }}">
  <div class="password__inner text-center">

    {%- if settings.logo != blank -%}
      {{
        settings.logo
        | image_url: width: 660
        | image_tag:
          class: 'password__logo',
          alt: shop.name
      }}
    {%- else -%}
      <p class="password__title">{{ shop.name }}</p>
    {%- endif -%}

    <h1 class="password__title">
      {{ section.settings.heading }}
    </h1>

    <div class="password__description">
      {{ section.settings.description | escape | newline_to_br }}
    </div>

    {%- if shop.password_message != blank -%}
      <div class="password__description">
        {{ shop.password_message }}
      </div>
    {%- endif -%}

    <div class="password__newsletter">
      {% render 'newsletter-form', id: section.id %}
    </div>

    <div class="password__footer">
      <details class="password__login">
        <summary class="link">
          {{ 'general.password_page.login_link' | t }}
        </summary>

        {%- form 'storefront_password', class: 'customer__form' -%}
          {%- if form.errors -%}
            <div class="form-message form-message--error">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <label class="field">
            <span class="field__label">
              {{ 'general.password_page.password' | t }}
            </span>
            <input
              class="field__input"
              type="password"
              name="password"
              autocomplete="current-password"
              required
            >
          </label>

          <button type="submit" class="button">
            {{ 'general.password_page.enter' | t }}
          </button>
        {%- endform -%}
      </details>

      {% render 'social-icons' %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Senha",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Falta pouco para sentir."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Texto de apresentação",
      "default": "Conheça Vanilla Cashmere, nossa primeira fragrância. Deixe seu e-mail para saber quando a pré-venda começar."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cores",
      "default": "scheme-2"
    }
  ]
}
{% endschema %}
