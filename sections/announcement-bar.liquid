{%- liquid
  assign speed = section.settings.speed
-%}
<div class="announcement color-{{ section.settings.color_scheme }}{% if section.settings.style == 'marquee' %} announcement--marquee{% endif %}" style="--marquee-speed: {{ speed }}s;">
  {%- if section.settings.style == 'marquee' -%}
    <div class="marquee" aria-label="{{ 'sections.announcement.label' | t }}">
      {%- for i in (1..2) -%}
        <div class="marquee__track"{% if forloop.last %} aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            {%- for j in (1..3) -%}
              <span class="announcement__item" {% if forloop.first %}{{ block.shopify_attributes }}{% endif %}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
                {%- else -%}
                  {{ block.settings.text }}
                {%- endif -%}
              </span>
              <span class="announcement__sep" aria-hidden="true">{% render 'icon', icon: 'sparkle' %}</span>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <announcement-slider class="announcement__slider page-width" data-autoplay="{{ section.settings.autoplay }}">
      {%- for block in section.blocks -%}
        <p class="announcement__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </p>
      {%- endfor -%}
    </announcement-slider>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Barra de anúncios",
  "class": "section-announcement",
  "max_blocks": 8,
  "settings": [
    { "type": "select", "id": "style", "label": "Estilo", "options": [ { "value": "marquee", "label": "Texto deslizante" }, { "value": "slider", "label": "Alternar mensagens" } ], "default": "marquee" },
    { "type": "range", "id": "speed", "min": 10, "max": 80, "step": 2, "unit": "s", "label": "Velocidade do texto deslizante", "default": 36 },
    { "type": "checkbox", "id": "autoplay", "label": "Alternar mensagens automaticamente", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de cores", "default": "scheme-5" }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Anúncio",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "Frete grátis acima de R$ 199" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra de anúncios",
      "blocks": [
        { "type": "announcement" }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
