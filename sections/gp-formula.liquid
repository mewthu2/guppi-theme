<section class="gp gp-pdp gp-pdp-cream-scroll" data-gp-cream>
  <div class="gp-pdp-cream">
    {%- if section.settings.intro != blank -%}<p class="gp-pdp-cream-intro">{{ section.settings.intro | newline_to_br }}</p>{%- endif -%}
    <div class="gp-pdp-cream-layout">
      <div class="gp-pdp-cream-photo-wrap" aria-hidden="true">
        {%- liquid
          assign texture = section.settings.texture | default: 'creme'
          case texture
            when 'oleo'
              assign texture_file = 'guppi-oleo.webp'
              assign texture_w = 900
              assign texture_h = 774
            when 'manteiga'
              assign texture_file = 'guppi-manteiga.webp'
              assign texture_w = 520
              assign texture_h = 799
            else
              assign texture_file = 'guppi-cream.webp'
              assign texture_w = 480
              assign texture_h = 1320
          endcase
        -%}
        <div class="gp-pdp-cream-fig gp-pdp-cream-fig--{{ texture }}">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 700 | image_tag: class: 'gp-pdp-cream-img', widths: '250, 500, 700', sizes: '(min-width: 990px) 260px, 170px', alt: '' }}
          {%- else -%}
            <img class="gp-pdp-cream-img" src="{{ texture_file | asset_url }}" alt="" width="{{ texture_w }}" height="{{ texture_h }}" loading="lazy">
          {%- endif -%}
        </div>
      </div>
      <ul class="gp-pdp-bullets">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Güppi · Fórmula (creme)",
  "settings": [
    { "type": "textarea", "id": "intro", "label": "Título", "default": "O cuidado começa\nna fórmula." },
    { "type": "select", "id": "texture", "label": "Textura", "options": [ { "value": "creme", "label": "Creme (hidratante)" }, { "value": "oleo", "label": "Óleo" }, { "value": "manteiga", "label": "Manteiga" } ], "default": "creme" },
    { "type": "image_picker", "id": "image", "label": "Imagem própria (opcional)", "info": "PNG ou WebP com fundo transparente. Substitui a textura escolhida acima." }
  ],
  "blocks": [
    { "type": "item", "name": "Ingrediente", "settings": [ { "type": "text", "id": "text", "label": "Texto", "default": "Manteiga de karité" } ] }
  ],
  "presets": [
    {
      "name": "Güppi · Fórmula (creme)",
      "blocks": [
        { "type": "item", "settings": { "text": "Manteiga de karité" } },
        { "type": "item", "settings": { "text": "Ácido hialurônico · 7 pesos moleculares" } },
        { "type": "item", "settings": { "text": "Óleo de macadâmia" } },
        { "type": "item", "settings": { "text": "Óleo de coco" } },
        { "type": "item", "settings": { "text": "Óleo de girassol" } },
        { "type": "item", "settings": { "text": "Óleo de argan" } },
        { "type": "item", "settings": { "text": "Óleo de linhaça" } },
        { "type": "item", "settings": { "text": "Óleo de oliva" } },
        { "type": "item", "settings": { "text": "Óleo de abacate" } },
        { "type": "item", "settings": { "text": "Óleo de semente de uva" } }
      ]
    }
  ]
}
{% endschema %}
