<section class="section faq color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width faq__grid">
    <div class="faq__intro reveal">
      {%- if section.settings.subheading != blank -%}<p class="subheading">{{ section.settings.subheading }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="button button--secondary">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
    <div class="accordion-group reveal">
      {%- for block in section.blocks -%}
        <details class="accordion" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary class="accordion__summary">
            <span>{{ block.settings.question }}</span>
            <span class="accordion__icon">{% render 'icon', icon: 'plus' %}</span>
          </summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Perguntas frequentes",
  "class": "section-faq",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "FAQ" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Dúvidas frequentes" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Não encontrou o que procurava? Fale com a gente.</p>" },
    { "type": "text", "id": "button_label", "label": "Botão", "default": "Contato" },
    { "type": "url", "id": "button_link", "label": "Link do botão" },
    { "type": "checkbox", "id": "open_first", "label": "Abrir a primeira pergunta", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de cores", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Espaçamento superior", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Espaçamento inferior", "default": 64 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Pergunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pergunta", "default": "Qual o prazo de entrega?" },
        { "type": "richtext", "id": "answer", "label": "Resposta", "default": "<p>Enviamos em até 2 dias úteis. O prazo varia conforme sua região.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Perguntas frequentes",
      "blocks": [
        { "type": "question" },
        { "type": "question", "settings": { "question": "Os produtos são veganos?", "answer": "<p>Sim! Todos os nossos produtos são 100% veganos e cruelty-free.</p>" } },
        { "type": "question", "settings": { "question": "Posso trocar ou devolver?", "answer": "<p>Você tem até 7 dias após o recebimento para solicitar troca ou devolução.</p>" } }
      ]
    }
  ]
}
{% endschema %}
