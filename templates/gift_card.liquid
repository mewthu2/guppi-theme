{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    {%- assign gift_value = gift_card.initial_value | money -%}
    <title>{{ 'gift_cards.issued.title' | t: value: gift_value, shop: shop.name }}</title>
    {% render 'css-variables' %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="template-gift-card color-{{ settings.color_schemes.first.id }}">
    <main class="gift-card page-width page-width--narrow text-center">
      <p class="h3">{{ shop.name }}</p>
      <h1 class="h1">{{ 'gift_cards.issued.subtext' | t }}</h1>
      <div class="gift-card__card">
        <img src="{{ 'gift-card/card.svg' | shopify_asset_url }}" alt="" width="570" height="356" loading="lazy">
        <p class="h2">{{ gift_card.balance | money }}</p>
        {%- if gift_card.enabled == false or gift_card.expired -%}
          <p class="badge badge--soldout">{{ 'gift_cards.issued.expired' | t }}</p>
        {%- endif -%}
      </div>
      {%- if gift_card.expires_on -%}
        {%- assign expires = gift_card.expires_on | date: '%d/%m/%Y' -%}
        <p>{{ 'gift_cards.issued.expiration_date' | t: expires_on: expires }}</p>
      {%- endif -%}
      <p class="gift-card__code"><strong>{{ gift_card.code | format_code }}</strong></p>
      <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}" class="gift-card__qr"></div>
      <div class="button-group button-group--center">
        <a href="{{ shop.url }}" class="button">{{ 'gift_cards.issued.shop_link' | t }}</a>
        <button type="button" class="button button--secondary" onclick="window.print();">{{ 'gift_cards.issued.print' | t }}</button>
      </div>
      {%- if gift_card.pass_url -%}
        <a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}" loading="lazy"></a>
      {%- endif -%}
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
