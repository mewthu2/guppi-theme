<section class="password color-{{ section.settings.color_scheme }}">
  <div class="password__inner text-center">
    {%- if settings.logo != blank -%}
      {{ settings.logo | image_url: width: 400 | image_tag: class: 'password__logo', alt: shop.name }}
    {%- else -%}
      <p class="h2">{{ shop.name }}</p>
    {%- endif -%}
    <h1 class="h0">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
    {% render 'newsletter-form', id: section.id %}
    <details class="password__login">
      <summary class="link">{{ 'general.password_page.login_link' | t }}</summary>
      {%- form 'storefront_password', class: 'customer__form' -%}
        {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label class="field"><span class="field__label">{{ 'general.password_page.password' | t }}</span><input class="field__input" type="password" name="password" autocomplete="current-password" required></label>
        <button type="submit" class="button">{{ 'general.password_page.enter' | t }}</button>
      {%- endform -%}
    </details>
    {% render 'social-icons' %}
  </div>
</section>

{% schema %}
{
  "name": "Senha",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Em breve" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de cores", "default": "scheme-2" }
  ]
}
{% endschema %}
