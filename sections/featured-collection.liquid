{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.limit
  if section.settings.products != blank
    assign products = section.settings.products
  else
    assign products = collection.products
  endif
-%}
<section class="section featured-collection color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section-header section-header--row">
      <div>
        {%- if section.settings.subheading != blank -%}<p class="subheading">{{ section.settings.subheading }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.show_view_all and collection != blank -%}
        <a href="{{ collection.url }}" class="link link--arrow">{{ 'sections.featured_collection.view_all' | t }} {% render 'icon', icon: 'arrow-right' %}</a>
      {%- endif -%}
    </div>

    {%- if section.settings.layout == 'carousel' -%}
      <slider-component class="slider">
        <ul class="product-grid slider__track" role="list" style="--columns: {{ section.settings.columns }};" data-track>
          {%- for product in products limit: limit -%}
            <li class="slider__item">{% render 'product-card', product: product %}</li>
          {%- else -%}
            {%- for i in (1..4) -%}
              <li class="slider__item">{% render 'product-card-placeholder' %}</li>
            {%- endfor -%}
          {%- endfor -%}
        </ul>
        <div class="slider__buttons">
          <button type="button" class="icon-button icon-button--filled" data-prev aria-label="{{ 'accessibility.previous_slide' | t }}">{% render 'icon', icon: 'chevron-left' %}</button>
          <button type="button" class="icon-button icon-button--filled" data-next aria-label="{{ 'accessibility.next_slide' | t }}">{% render 'icon', icon: 'chevron-right' %}</button>
        </div>
      </slider-component>
    {%- else -%}
      <ul class="product-grid" role="list" style="--columns: {{ section.settings.columns }};">
        {%- for product in products limit: limit -%}
          <li class="reveal">{% render 'product-card', product: product %}</li>
        {%- else -%}
          {%- for i in (1..4) -%}
            <li>{% render 'product-card-placeholder' %}</li>
          {%- endfor -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Coleção em destaque",
  "class": "section-featured-collection",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subtítulo" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Os mais vendidos" },
    { "type": "collection", "id": "collection", "label": "Coleção" },
    { "type": "product_list", "id": "products", "label": "Ou escolha produtos", "limit": 24 },
    { "type": "range", "id": "limit", "min": 2, "max": 24, "step": 1, "label": "Máximo de produtos", "default": 8 },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Colunas no desktop", "default": 4 },
    { "type": "select", "id": "layout", "label": "Layout", "options": [ { "value": "carousel", "label": "Carrossel" }, { "value": "grid", "label": "Grade" } ], "default": "carousel" },
    { "type": "checkbox", "id": "show_view_all", "label": "Mostrar link \"Ver todos\"", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de cores", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Espaçamento superior", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Espaçamento inferior", "default": 64 }
  ],
  "presets": [ { "name": "Coleção em destaque" } ]
}
{% endschema %}
