{%- liquid
  assign gp_top_msgs = ''
  if section.settings.top_on
    for i in (1..3)
      assign key = 'top_text_' | append: i
      if section.settings[key] != blank
        assign gp_top_msgs = gp_top_msgs | append: i | append: ','
      endif
    endfor
  endif
-%}
{%- if gp_top_msgs != blank -%}
  <style>body { --gp-top-h: 28px; } @media (min-width: 990px) { body.gp-wide { --gp-top-h: 32px; } }</style>
{%- endif -%}
<div class="gp gp-hdr-wrap{% if template.name == 'index' %} gp-hdr-wrap--home{% endif %}" data-gp-hdr>
  {%- if gp_top_msgs != blank -%}
    {%- assign gp_top_list = gp_top_msgs | split: ',' -%}
    <div class="gp-top" style="--gp-top-bg: {{ section.settings.top_bg }}; --gp-top-fg: {{ section.settings.top_fg }};" data-gp-top>
      {%- for i in gp_top_list -%}
        {%- assign tkey = 'top_text_' | append: i -%}
        {%- assign lkey = 'top_link_' | append: i -%}
        {%- if section.settings[lkey] != blank -%}
          <a class="gp-top-msg{% if forloop.first %} is-on{% endif %}" href="{{ section.settings[lkey] }}">{{ section.settings[tkey] }}</a>
        {%- else -%}
          <p class="gp-top-msg{% if forloop.first %} is-on{% endif %}">{{ section.settings[tkey] }}</p>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
  <header class="gp-hdr">
    <button class="gp-ico" id="GpMenuBtn" type="button" aria-label="{{ 'sections.header.menu' | t }}" aria-expanded="false" aria-controls="GpMenu">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path class="gp-p-bars" d="M4 7h16M4 12h16M4 17h16"/><path class="gp-p-x" d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <a class="gp-logo-link" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: class: 'gp-logo', alt: shop.name, widths: '200, 300, 400' }}
      {%- else -%}
        {%- comment -%} Segunda cópia mostra só o pingo direito do Ü, que pisca como no peixe do rodapé {%- endcomment -%}
        <span class="gp-logo-wink">
          <img class="gp-logo gp-logo-base" src="{{ 'guppi-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="310" height="110">
          <img class="gp-logo gp-logo-lid" src="{{ 'guppi-logo.png' | asset_url }}" alt="" aria-hidden="true" width="310" height="110">
        </span>
      {%- endif -%}
    </a>
    <nav class="gp-nav" aria-label="{{ 'sections.header.menu' | t }}">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.soon or block.settings.link == blank -%}
            <span class="gp-nav-item off{% if block.settings.logo_font %} gp-logo-font{% endif %}" aria-disabled="true">{{ block.settings.label }}{% if block.settings.soon %}<small>{{ block.settings.soon_label }}</small>{% endif %}</span>
          {%- else -%}
            <a class="gp-nav-item{% if block.settings.logo_font %} gp-logo-font{% endif %}" href="{{ block.settings.link }}">{{ block.settings.label }}</a>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for link in section.settings.menu.links -%}
          <a class="gp-nav-item" href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- endif -%}
    </nav>
    <div class="gp-right">
      <a class="gp-ico" href="{{ routes.search_url }}" data-open-search aria-label="{{ 'general.search.search' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg>
      </a>
      <a class="gp-ico" href="{{ routes.cart_url }}" data-open-cart aria-label="{{ 'cart.general.title' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.5 8.5h13l-1 11h-11z"/><path d="M9 8.5V7a3 3 0 016 0v1.5"/></svg>
        <span class="gp-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </header>
  {%- if section.settings.wave -%}
    {% render 'gp-wave', class: 'gp-wave--hdr', front: section.settings.wave_color, middle: section.settings.wave_color_2, back: section.settings.wave_color_3 %}
  {%- endif -%}
</div>

<div class="gp gp-menu-wrap" id="GpMenu" aria-hidden="true">
  <div class="gp-menu-backdrop" data-gp-menu-close></div>
  <nav class="gp-menu" aria-label="{{ 'sections.header.menu' | t }}">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.soon or block.settings.link == blank -%}
          <span class="gp-m-item off{% if block.settings.logo_font %} gp-logo-font{% endif %}" aria-disabled="true" {{ block.shopify_attributes }}>{{ block.settings.label }}{% if block.settings.soon %}<small>{{ block.settings.soon_label }}</small>{% endif %}</span>
        {%- else -%}
          <a class="gp-m-item{% if block.settings.logo_font %} gp-logo-font{% endif %}" href="{{ block.settings.link }}" data-gp-menu-close {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- for link in section.settings.menu.links -%}
        <a class="gp-m-item" href="{{ link.url }}" data-gp-menu-close>{{ link.title }}</a>
      {%- endfor -%}
    {%- endif -%}
  </nav>
</div>

<dialog class="modal search-modal color-{{ section.settings.color_scheme }}" id="SearchModal" aria-label="{{ 'general.search.search' | t }}">
  <div class="search-modal__inner page-width">
    <predictive-search data-enabled="{{ settings.predictive_search_enabled }}">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
        <label class="visually-hidden" for="SearchModalInput">{{ 'general.search.search' | t }}</label>
        {% render 'icon', icon: 'search', class: 'search-form__icon' %}
        <input
          id="SearchModalInput"
          class="search-form__input"
          type="search"
          name="q"
          placeholder="{{ 'general.search.placeholder' | t }}"
          autocomplete="off"
          role="combobox"
          aria-expanded="false"
          aria-controls="PredictiveResults"
          aria-autocomplete="list"
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button type="button" class="icon-button" data-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button>
      </form>
      <div class="predictive-results" id="PredictiveResults" aria-live="polite"></div>
    </predictive-search>
  </div>
</dialog>

<script>
  (function () {
    var top = document.querySelector('[data-gp-top]');
    if (!top) return;
    var msgs = top.querySelectorAll('.gp-top-msg');
    if (msgs.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var i = 0;
    setInterval(function () {
      msgs[i].classList.remove('is-on');
      i = (i + 1) % msgs.length;
      msgs[i].classList.add('is-on');
    }, 4500);
  })();
</script>

<script>
  (function () {
    var wrap = document.querySelector('[data-gp-hdr]');
    if (!wrap || !wrap.classList.contains('gp-hdr-wrap--home')) return;
    var ticking = false;
    function sync() { wrap.classList.toggle('is-scrolled', window.scrollY > 24); ticking = false; }
    window.addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(sync); } }, { passive: true });
    sync();
  })();
</script>

{% schema %}
{
  "name": "Cabeçalho Güppi",
  "class": "section-gp-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Use a versão clara do logo. Sem imagem, usa o logo Güppi padrão." },
    { "type": "link_list", "id": "menu", "label": "Menu", "info": "Usado quando não há itens adicionados como blocos.", "default": "main-menu" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de cores da busca", "default": "scheme-1" },
    { "type": "header", "content": "Barra do topo" },
    { "type": "checkbox", "id": "top_on", "label": "Mostrar barra acima do cabeçalho", "default": true },
    { "type": "text", "id": "top_text_1", "label": "Mensagem 1", "default": "Bem-vindo à Güppi" },
    { "type": "url", "id": "top_link_1", "label": "Link da mensagem 1" },
    { "type": "text", "id": "top_text_2", "label": "Mensagem 2", "info": "Com mais de uma mensagem, elas se alternam a cada poucos segundos." },
    { "type": "url", "id": "top_link_2", "label": "Link da mensagem 2" },
    { "type": "text", "id": "top_text_3", "label": "Mensagem 3" },
    { "type": "url", "id": "top_link_3", "label": "Link da mensagem 3" },
    { "type": "color", "id": "top_bg", "label": "Cor de fundo da barra", "default": "#322C3D" },
    { "type": "color", "id": "top_fg", "label": "Cor do texto da barra", "default": "#F6F3EA" },
    { "type": "header", "content": "Ondas do cabeçalho" },
    { "type": "checkbox", "id": "wave", "label": "Mostrar ondas abaixo do cabeçalho", "info": "Na home as ondas começam grandes sobre o vídeo e diminuem ao rolar. Nas outras páginas ficam sempre pequenas.", "default": true },
    { "type": "color", "id": "wave_color", "label": "Cor da onda da frente", "info": "Use a cor do cabeçalho para a onda emendar nele.", "default": "#9B7FC9" },
    { "type": "color", "id": "wave_color_2", "label": "Cor da onda do meio", "default": "#BB9CC5" },
    { "type": "color", "id": "wave_color_3", "label": "Cor da onda de trás", "default": "#DECFF0" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item do menu",
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "Produtos" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "soon", "label": "Marcar como em breve", "default": false },
        { "type": "text", "id": "soon_label", "label": "Texto de em breve", "default": "Em breve" },
        { "type": "checkbox", "id": "logo_font", "label": "Usar a fonte do logo", "default": false }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
