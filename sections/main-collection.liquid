<section class="section main-collection color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;" id="ResultsSection-{{ section.id }}">
  <div class="page-width">
    {%- paginate collection.products by section.settings.per_page -%}
      {% render 'facets', results: collection, section_id: section.id, enable_sorting: section.settings.enable_sorting %}

      <div class="results" id="Results-{{ section.id }}">
        {%- if collection.products.size == 0 -%}
          <div class="empty-state">
            <p class="h4">{{ 'sections.collection.empty' | t }}</p>
            <a href="{{ collection.url }}" class="button button--secondary" data-facet-link>{{ 'products.facets.clear_all' | t }}</a>
          </div>
        {%- else -%}
          <ul class="product-grid" role="list" style="--columns: {{ section.settings.columns }}; --columns-mobile: {{ section.settings.columns_mobile }};">
            {%- for product in collection.products -%}
              {%- liquid
                assign lazy = true
                if forloop.index <= 4
                  assign lazy = false
                endif
              -%}
              <li>{% render 'product-card', product: product, lazy: lazy %}</li>
              {%- if section.settings.promo_image != blank and forloop.index == section.settings.promo_position and paginate.current_page == 1 -%}
                <li class="promo-tile color-{{ section.settings.promo_color_scheme }}">
                  <a href="{{ section.settings.promo_link | default: '#' }}" class="promo-tile__link">
                    {{ section.settings.promo_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', class: 'promo-tile__img' }}
                    <span class="promo-tile__content">
                      <span class="h3">{{ section.settings.promo_heading }}</span>
                      {%- if section.settings.promo_button != blank -%}<span class="button button--small">{{ section.settings.promo_button }}</span>{%- endif -%}
                    </span>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      </div>
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Grade de produtos",
  "class": "section-main-collection",
  "settings": [
    { "type": "range", "id": "per_page", "min": 8, "max": 48, "step": 4, "label": "Produtos por página", "default": 24 },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Colunas no desktop", "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "Colunas no mobile", "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ], "default": "2" },
    { "type": "checkbox", "id": "enable_sorting", "label": "Permitir ordenação", "default": true },
    { "type": "header", "content": "Card promocional" },
    { "type": "image_picker", "id": "promo_image", "label": "Imagem" },
    { "type": "range", "id": "promo_position", "min": 1, "max": 12, "step": 1, "label": "Posição na grade", "default": 3 },
    { "type": "text", "id": "promo_heading", "label": "Título", "default": "Kits com até 40% off" },
    { "type": "text", "id": "promo_button", "label": "Botão", "default": "Ver kits" },
    { "type": "url", "id": "promo_link", "label": "Link" },
    { "type": "color_scheme", "id": "promo_color_scheme", "label": "Esquema de cores do card", "default": "scheme-4" },
    { "type": "header", "content": "Espaçamento" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de cores", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Espaçamento superior", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Espaçamento inferior", "default": 64 }
  ],
  "enabled_on": { "templates": ["collection"] }
}
{% endschema %}
