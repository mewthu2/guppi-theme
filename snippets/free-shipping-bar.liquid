{% doc %}
  Renders a progress bar toward free shipping.

  @example
  {% render 'free-shipping-bar' %}
{% enddoc %}
{%- if settings.free_shipping_threshold != blank -%}
  {%- liquid
    assign threshold = settings.free_shipping_threshold | times: 100 | round
    assign remaining = threshold | minus: cart.total_price
    assign progress = cart.total_price | times: 100.0 | divided_by: threshold | at_most: 100
  -%}
  <div class="shipping-bar">
    <p class="shipping-bar__text">
      {%- if remaining > 0 -%}
        {%- assign remaining_money = remaining | money -%}
        {{ 'cart.general.free_shipping_remaining_html' | t: amount: remaining_money }}
      {%- else -%}
        {% render 'icon', icon: 'truck' %} {{ 'cart.general.free_shipping_unlocked' | t }}
      {%- endif -%}
    </p>
    <div class="shipping-bar__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress | round }}">
      <span class="shipping-bar__fill" style="width: {{ progress }}%"></span>
    </div>
  </div>
{%- endif -%}
