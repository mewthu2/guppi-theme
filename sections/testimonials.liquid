<section class="section testimonials color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header text-center">
        {%- if section.settings.subheading != blank -%}<p class="subheading">{{ section.settings.subheading }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <slider-component class="slider">
      <ul class="testimonials__track slider__track" role="list" style="--columns: {{ section.settings.columns }};" data-track>
        {%- for block in section.blocks -%}
          <li class="slider__item" {{ block.shopify_attributes }}>
            <figure class="testimonial">
              <div class="testimonial__stars" aria-label="{{ 'products.product.rating' | t: rating: block.settings.rating, max: 5 }}">
                {%- for i in (1..block.settings.rating) -%}{% render 'icon', icon: 'star' %}{%- endfor -%}
              </div>
              <blockquote class="testimonial__quote">{{ block.settings.quote }}</blockquote>
              <figcaption class="testimonial__author">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 120, height: 120, crop: 'center' | image_tag: loading: 'lazy', class: 'testimonial__avatar', alt: block.settings.author }}
                {%- endif -%}
                <span>
                  <strong>{{ block.settings.author }}</strong>
                  {%- if block.settings.product != blank -%}
                    <a href="{{ block.settings.product.url }}" class="testimonial__product">{{ block.settings.product.title }}</a>
                  {%- endif -%}
                </span>
              </figcaption>
            </figure>
          </li>
        {%- endfor -%}
      </ul>
      <div class="slider__buttons">
        <button type="button" class="icon-button icon-button--filled" data-prev aria-label="{{ 'accessibility.previous_slide' | t }}">{% render 'icon', icon: 'chevron-left' %}</button>
        <button type="button" class="icon-button icon-button--filled" data-next aria-label="{{ 'accessibility.next_slide' | t }}">{% render 'icon', icon: 'chevron-right' %}</button>
      </div>
    </slider-component>
  </div>
</section>

{% schema %}
{
  "name": "Depoimentos",
  "class": "section-testimonials",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Quem usa, ama" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "O que nossas clientes dizem" },
    { "type": "range", "id": "columns", "min": 1, "max": 4, "step": 1, "label": "Colunas no desktop", "default": 3 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de cores", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Espaçamento superior", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Espaçamento inferior", "default": 64 }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Depoimento",
      "settings": [
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Estrelas", "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Depoimento", "default": "Minha pele nunca esteve tão luminosa. A textura é leve e o cheirinho é maravilhoso!" },
        { "type": "text", "id": "author", "label": "Autor", "default": "Ana P." },
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "product", "id": "product", "label": "Produto avaliado" }
      ]
    }
  ],
  "presets": [
    { "name": "Depoimentos", "blocks": [ { "type": "testimonial" }, { "type": "testimonial", "settings": { "author": "Julia M.", "quote": "Virou item obrigatório na minha rotina. Recomendo demais!" } }, { "type": "testimonial", "settings": { "author": "Carla S.", "quote": "Chegou rápido, embalagem linda e resultado visível em poucas semanas." } } ] }
  ]
}
{% endschema %}
