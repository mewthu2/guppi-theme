<section class="gp gp-creators">
  {%- if section.settings.eyebrow != blank -%}<p class="gp-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  {%- if section.settings.title != blank -%}<h2 class="gp-title">{{ section.settings.title | newline_to_br }}</h2>{%- endif -%}
  <div class="gp-slider-wrap">
    <button class="gp-arrow prev" type="button" aria-label="Anterior" data-gp-scroll="Reels-{{ section.id }}" data-dir="-1"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg></button>
    <div class="gp-reels" id="Reels-{{ section.id }}" data-gp-drag>
      {%- for block in section.blocks -%}
        <div class="gp-reel" style="background: {{ block.settings.bg }};" {{ block.shopify_attributes }}>
          {%- if block.settings.video != blank -%}
            {{ block.settings.video | video_tag: class: 'gp-media-fill', autoplay: true, muted: true, loop: true, playsinline: true, controls: false, preload: 'metadata', image_size: '700x' }}
          {%- elsif block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 700 | image_tag: class: 'gp-media-fill', widths: '350, 700', sizes: '(min-width: 990px) 300px, 82vw', loading: 'lazy' }}
          {%- else -%}
            {%- if block.settings.title != blank -%}<strong>{{ block.settings.title | newline_to_br }}</strong>{%- endif -%}
            {%- if block.settings.caption != blank -%}<em>{{ block.settings.caption }}</em>{%- endif -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    <button class="gp-arrow next" type="button" aria-label="Próximo" data-gp-scroll="Reels-{{ section.id }}" data-dir="1"><svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg></button>
  </div>
</section>

{% schema %}
{
  "name": "Güppi · Creators",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Pele perfumada, todo dia" },
    { "type": "textarea", "id": "title", "label": "Título", "default": "A Güppi nas rotinas do dia a dia" }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Vídeo",
      "settings": [
        { "type": "video", "id": "video", "label": "Vídeo" },
        { "type": "image_picker", "id": "image", "label": "Imagem (se não houver vídeo)" },
        { "type": "textarea", "id": "title", "label": "Texto sem mídia", "default": "Vídeo\nCreator" },
        { "type": "text", "id": "caption", "label": "Legenda sem mídia" },
        { "type": "color", "id": "bg", "label": "Cor de fundo", "default": "#CF0058" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Güppi · Creators",
      "blocks": [
        { "type": "reel", "settings": { "title": "Vídeos\nCreators", "caption": "(arrastar para ver mais)" } },
        { "type": "reel", "settings": { "title": "Vídeo\nCreator 2" } },
        { "type": "reel", "settings": { "title": "Vídeo\nCreator 3" } },
        { "type": "reel", "settings": { "title": "Vídeo\nCreator 4" } }
      ]
    }
  ]
}
{% endschema %}
