#shopify-section-{{ section.id }} .password__inner {
  max-width: 820px;
}

#shopify-section-{{ section.id }} .password__logo {
  width: 480px;
  max-width: 90%;
  height: auto;
  margin-bottom: 40px;
}

#shopify-section-{{ section.id }} .password__title {
  font-size: clamp(30px, 3.5vw, 44px);
}

@media (max-width: 600px) {
  #shopify-section-{{ section.id }} .password__logo {
    width: 280px;
    margin-bottom: 32px;
  }
}
