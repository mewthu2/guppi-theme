<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      {%- comment -%} Ü do rodapé como favicon {%- endcomment -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'guppi-favicon.svg' | asset_url }}">
      <link rel="icon" type="image/png" sizes="96x96" href="{{ 'guppi-favicon.png' | asset_url }}">
    {%- endif -%}
    <link rel="apple-touch-icon" href="{{ 'guppi-apple-touch.png' | asset_url }}">
    <title>{{ shop.name }}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {% render 'meta-tags' %}
    {% render 'css-variables' %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
