<section class="section rich-text color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="rich-text__inner text-{{ section.settings.alignment }} rich-text--{{ section.settings.width }} reveal">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'subheading' -%}
            <p class="subheading" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
          {%- when 'heading' -%}
            <h2 class="{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
          {%- when 'text' -%}
            <div class="rte rich-text__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'icons' -%}
            <ul class="icon-list" role="list" {{ block.shopify_attributes }}>
              {%- for i in (1..3) -%}
                {%- assign icon_key = 'icon_' | append: i -%}
                {%- assign label_key = 'label_' | append: i -%}
                {%- if block.settings[label_key] != blank -%}
                  <li class="icon-list__item">{% render 'icon', icon: block.settings[icon_key] %} {{ block.settings[label_key] }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- when 'button' -%}
            <div class="button-group" {{ block.shopify_attributes }}>
              {%- if block.settings.label != blank -%}
                <a href="{{ block.settings.link | default: '#' }}" class="button{% if block.settings.secondary %} button--secondary{% endif %}">{{ block.settings.label }}</a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Texto rico",
  "class": "section-rich-text",
  "settings": [
    { "type": "text_alignment", "id": "alignment", "label": "Alinhamento", "default": "center" },
    { "type": "select", "id": "width", "label": "Largura", "options": [ { "value": "narrow", "label": "Estreita" }, { "value": "wide", "label": "Larga" } ], "default": "narrow" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de cores", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Espaçamento superior", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Espaçamento inferior", "default": 32 }
  ],
  "blocks": [
    { "type": "subheading", "name": "Subtítulo", "settings": [ { "type": "text", "id": "text", "label": "Texto", "default": "Subtítulo" } ] },
    {
      "type": "heading",
      "name": "Título",
      "settings": [
        { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Conte sua história" },
        { "type": "select", "id": "size", "label": "Tamanho", "options": [ { "value": "h3", "label": "Pequeno" }, { "value": "h2", "label": "Médio" }, { "value": "h1", "label": "Grande" }, { "value": "h0", "label": "Extra grande" } ], "default": "h2" }
      ]
    },
    { "type": "text", "name": "Texto", "settings": [ { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Compartilhe informações sobre sua marca com os clientes.</p>" } ] },
    {
      "type": "icons",
      "name": "Ícones com texto",
      "settings": [
        { "type": "select", "id": "icon_1", "label": "Ícone 1", "options": [ { "value": "heart", "label": "Coração" }, { "value": "leaf", "label": "Folha" }, { "value": "sparkle", "label": "Brilho" }, { "value": "drop", "label": "Gota" }, { "value": "shield", "label": "Escudo" }, { "value": "truck", "label": "Caminhão" }, { "value": "gift", "label": "Presente" }, { "value": "globe", "label": "Globo" } ], "default": "heart" },
        { "type": "text", "id": "label_1", "label": "Texto 1", "default": "Cruelty-free" },
        { "type": "select", "id": "icon_2", "label": "Ícone 2", "options": [ { "value": "heart", "label": "Coração" }, { "value": "leaf", "label": "Folha" }, { "value": "sparkle", "label": "Brilho" }, { "value": "drop", "label": "Gota" }, { "value": "shield", "label": "Escudo" }, { "value": "truck", "label": "Caminhão" }, { "value": "gift", "label": "Presente" }, { "value": "globe", "label": "Globo" } ], "default": "leaf" },
        { "type": "text", "id": "label_2", "label": "Texto 2", "default": "100% vegano" },
        { "type": "select", "id": "icon_3", "label": "Ícone 3", "options": [ { "value": "heart", "label": "Coração" }, { "value": "leaf", "label": "Folha" }, { "value": "sparkle", "label": "Brilho" }, { "value": "drop", "label": "Gota" }, { "value": "shield", "label": "Escudo" }, { "value": "truck", "label": "Caminhão" }, { "value": "gift", "label": "Presente" }, { "value": "globe", "label": "Globo" } ], "default": "globe" },
        { "type": "text", "id": "label_3", "label": "Texto 3", "default": "Feito no Brasil" }
      ]
    },
    {
      "type": "button",
      "name": "Botão",
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "Saiba mais" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "secondary", "label": "Estilo secundário", "default": false }
      ]
    }
  ],
  "presets": [
    { "name": "Texto rico", "blocks": [ { "type": "subheading" }, { "type": "heading" }, { "type": "text" }, { "type": "button" } ] }
  ]
}
{% endschema %}
