<section class="gp gp-hero" style="background: {{ section.settings.bg }};">
  {%- liquid
    assign d_video = section.settings.video
    assign d_image = section.settings.image
    assign m_video = section.settings.video_mobile
    assign m_image = section.settings.image_mobile
    if m_video == blank and m_image == blank
      assign m_video = d_video
      assign m_image = d_image
    endif
    assign split = true
    if m_video == d_video and m_image == d_image
      assign split = false
    endif
  -%}
  {%- if split == false -%}
    {%- if d_video != blank -%}
      {{ d_video | video_tag: class: 'gp-media-fill', autoplay: true, muted: true, loop: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1920x' }}
    {%- elsif d_image != blank -%}
      {{ d_image | image_url: width: 2400 | image_tag: class: 'gp-media-fill', widths: '430, 860, 1100, 1600, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high' }}
    {%- else -%}
      <div class="gp-slot">{{ section.settings.placeholder }}</div>
    {%- endif -%}
  {%- else -%}
    {%- comment -%} Celular abaixo de 750px, desktop a partir daí. Vídeos só tocam quando visíveis (guppi.js), para não baixar os dois. {%- endcomment -%}
    {%- if m_video != blank -%}
      {{ m_video | video_tag: class: 'gp-media-fill gp-only-mobile', muted: true, loop: true, playsinline: true, controls: false, preload: 'none', image_size: '860x' }}
    {%- elsif m_image != blank -%}
      {{ m_image | image_url: width: 1300 | image_tag: class: 'gp-media-fill gp-only-mobile', widths: '430, 650, 860, 1100, 1300', sizes: '100vw', loading: 'eager', fetchpriority: 'high' }}
    {%- else -%}
      <div class="gp-slot gp-only-mobile">{{ section.settings.placeholder }}</div>
    {%- endif -%}
    {%- if d_video != blank -%}
      {{ d_video | video_tag: class: 'gp-media-fill gp-only-desktop', muted: true, loop: true, playsinline: true, controls: false, preload: 'none', image_size: '1920x' }}
    {%- elsif d_image != blank -%}
      {{ d_image | image_url: width: 2400 | image_tag: class: 'gp-media-fill gp-only-desktop', widths: '1100, 1600, 2000, 2400', sizes: '100vw', loading: 'lazy' }}
    {%- else -%}
      <div class="gp-slot gp-only-desktop">{{ section.settings.placeholder }}</div>
    {%- endif -%}
  {%- endif -%}
  {% render 'gp-wave', front: section.settings.wave_color, middle: section.settings.wave_color_2, back: section.settings.wave_color_3 %}
</section>

{% schema %}
{
  "name": "Güppi · Abertura",
  "settings": [
    { "type": "header", "content": "Desktop" },
    { "type": "video", "id": "video", "label": "Vídeo", "info": "Toca sem som, em loop. Use um vídeo horizontal." },
    { "type": "image_picker", "id": "image", "label": "Imagem (se não houver vídeo)" },
    { "type": "header", "content": "Celular" },
    { "type": "video", "id": "video_mobile", "label": "Vídeo", "info": "Use um vídeo vertical. Sem vídeo nem imagem aqui, o celular usa os do desktop." },
    { "type": "image_picker", "id": "image_mobile", "label": "Imagem (se não houver vídeo)" },
    { "type": "header", "content": "Aparência" },
    { "type": "text", "id": "placeholder", "label": "Texto sem mídia", "default": "Vídeo" },
    { "type": "color", "id": "bg", "label": "Cor de fundo", "default": "#DECFF0" },
    { "type": "color", "id": "wave_color", "label": "Cor da onda", "default": "#F6F3EC" },
    { "type": "color", "id": "wave_color_2", "label": "Cor da onda do meio", "default": "#BB9CC5" },
    { "type": "color", "id": "wave_color_3", "label": "Cor da onda de trás", "default": "#9B7FC9" }
  ],
  "presets": [{ "name": "Güppi · Abertura" }]
}
{% endschema %}
